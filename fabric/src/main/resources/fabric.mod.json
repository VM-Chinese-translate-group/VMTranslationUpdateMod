{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "The VM Chinese translate Group mod is used to check Chinese localization patches and some other utility features.",
  "authors": [
    "Wulian233", "TexTrue"
  ],
  "contact": {
    "homepage": "https://vmct-cn.top/vmtu",
    "sources": "https://github.com/VM-Chinese-translate-group/VMTranslationUtilityMod",
    "issues": "https://github.com/VM-Chinese-translate-group/VMTranslationUtilityMod/issues"
  },
  "license": "MIT",
  "icon": "assets/${id}/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "top.vmctcn.vmtu.mod.fabric.VMTranslationUpdateModClientFabric"
    ],
    "preLaunch": [
      "top.vmctcn.vmtu.mod.fabric.VMTranslationUpdateModPreLaunch"
    ],
    "modmenu": [
      "top.vmctcn.vmtu.mod.fabric.ModMenuImpl"
    ]
  },
  "mixins": [
    "vmtu-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": "*",
    "minecraft": "${minecraft}",
    "${clothconfig_id}": "*"
  }
}